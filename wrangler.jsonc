{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gespr-chsaufzeichnungen-e1c0",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "gespr-chsaufzeichnungen-e1c0"
    }
  ],
  // Live-Stand der Transkription (worker/live-status.ts).
  "durable_objects": {
    "bindings": [{ "name": "LIVE_STATUS", "class_name": "LiveStatus" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LiveStatus"] }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    "gespr-chsaufzeichnungen-e1c0.clawcorp.ai/*"
  ]
}
